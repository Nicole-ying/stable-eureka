{
  "objective_success_bonus": {
    "condition": "Both legs contact (state[6]==1 and state[7]==1) and |x|<0.15 and |y|<0.15 and |vy|<0.5",
    "value": 100.0
  },
  "crash_penalty": {
    "condition": "terminated and not success",
    "value": -100.0
  },
  "progress_shaping": {
    "distance_penalty": "-0.07 * (x^2 + y^2)",
    "angle_penalty": "-0.02 * angle^2"
  },
  "velocity_penalty": {
    "vertical": "-0.02 * vy^2",
    "lateral": "-0.01 * vx^2"
  },
  "fuel_penalty": {
    "main_engine": "-0.01 * m_power"
  },
  "distance_improvement_bonus": {
    "condition": "distance decreased from previous step",
    "value": "0.2 * (prev_distance - current_distance), capped at 0.5 per step"
  },
  "controlled_descent_bonus": {
    "condition": "m_power > 0 and (x^2 + y^2) < 0.3 and abs(angle) < 0.2",
    "value": 0.5
  },
  "touchdown_stability_bonus": {
    "condition": "leg1==1 and leg2==1 and abs(vy)<0.5 and abs(vx)<0.5 and abs(angle)<0.2 and (x^2 + y^2) < 0.3",
    "value": 10.0
  }
}