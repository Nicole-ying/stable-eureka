{
  "objective_success_bonus": {
    "condition": "Both legs contact (state[6]==1 and state[7]==1) and |x|<0.15 and |y|<0.15 and |vy|<0.5",
    "value": 100.0,
    "payment_mode": "one-shot event-gated"
  },
  "crash_penalty": {
    "condition": "terminated and not success",
    "value": -100.0,
    "payment_mode": "one-shot event-gated"
  },
  "progress_shaping": {
    "distance_penalty": "-0.05 * (x^2 + y^2)",
    "angle_penalty": "-0.02 * angle^2",
    "payment_mode": "per-step penalty"
  },
  "velocity_penalty": {
    "vertical": "-0.02 * vy^2",
    "lateral": "-0.01 * vx^2",
    "payment_mode": "per-step penalty"
  },
  "fuel_penalty": {
    "main_engine": "-0.01 * m_power",
    "payment_mode": "per-step penalty"
  },
  "distance_improvement_bonus": {
    "condition": "distance decreases from previous step",
    "value": "0.5 * (prev_distance - current_distance), capped at +1.0",
    "payment_mode": "per-step improvement-based"
  },
  "controlled_descent_bonus": {
    "condition": "first time m_power>0 and distance<0.5 and |angle|<0.2",
    "value": 0.5,
    "payment_mode": "one-shot event-gated"
  },
  "touchdown_stability_bonus": {
    "condition": "first time leg1==1 and leg2==1 and |vy|<0.5 and |vx|<0.5 and |angle|<0.2 and distance<0.15",
    "value": 10.0,
    "payment_mode": "one-shot event-gated"
  }
}