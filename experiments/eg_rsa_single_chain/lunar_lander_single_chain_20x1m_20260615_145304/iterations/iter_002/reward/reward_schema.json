{
  "objective_success_bonus": {
    "condition": "Both legs contact (state[6]==1 and state[7]==1) and |x|<0.15 and |y|<0.15 and |vy|<0.5",
    "value": 100.0,
    "payment_mode": "one-shot event-gated"
  },
  "crash_penalty": {
    "condition": "terminated and not success",
    "value": -100.0,
    "payment_mode": "one-shot event-gated"
  },
  "progress_shaping": {
    "distance_penalty": "-0.05 * (x^2 + y^2)",
    "angle_penalty": "-0.02 * angle^2",
    "payment_mode": "per-step penalty"
  },
  "velocity_penalty": {
    "vertical": "-0.02 * vy^2",
    "lateral": "-0.01 * vx^2",
    "payment_mode": "per-step penalty"
  },
  "fuel_penalty": {
    "main_engine": "-0.01 * m_power",
    "payment_mode": "per-step penalty"
  },
  "controlled_descent_bonus": {
    "condition": "m_power > 0 and (x^2 + y^2) < 0.5 and abs(angle) < 0.2 and not self._controlled_descent_collected",
    "value": 0.5,
    "payment_mode": "one-shot event-gated (once per episode)"
  },
  "touchdown_stability_bonus": {
    "condition": "leg1==1 and leg2==1 and abs(vy)<0.5 and abs(vx)<0.5 and abs(angle)<0.2 and not self._touchdown_stability_collected",
    "value": 10.0,
    "payment_mode": "one-shot event-gated (once per episode)"
  },
  "progress_bonus": {
    "condition": "distance_to_pad < self._prev_distance",
    "value": "0.1 * (self._prev_distance - distance_to_pad)",
    "payment_mode": "per-step improvement bonus"
  }
}