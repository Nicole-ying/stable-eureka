{
  "function_name": "compute_reward",
  "inputs": [
    {
      "name": "state",
      "type": "list[float]",
      "description": "8-dim state vector (x, y, vx, vy, angle, ang_vel, leg_l, leg_r)"
    },
    {
      "name": "m_power",
      "type": "float",
      "description": "Main engine power usage"
    },
    {
      "name": "s_power",
      "type": "float",
      "description": "Side engine power usage"
    },
    {
      "name": "terminated",
      "type": "bool",
      "description": "Episode termination flag"
    }
  ],
  "outputs": [
    {
      "name": "reward",
      "type": "float",
      "description": "Scalar reward for the step"
    },
    {
      "name": "individual_reward",
      "type": "dict",
      "description": "Diagnostics including fitness_score compatible keys"
    }
  ]
}