  "reward_code": "\"\"\"\nIter 1: Fix main engine avoidance.\n- Separate velocity penalties: stronger for horizontal drift, gentle for vertical\n- Sharper shaping: exp(-3*dist) for stronger gradient\n- Vertical control bonus: reward low vy when near ground\n- Keep: step_penalty, terminal=800, soft landing conditions\n\"\"\"\nimport numpy as np\n\ndef compute_reward(obs, action, next_obs, done, info):\n    x, y = next_obs[0], next_obs[1]\n    vx, vy = next_obs[2], next_obs[3]\n    angle = next_obs[4]\n    left_leg = next_obs[6]\n    right_leg = next_obs[7]\n\n    dist = np.sqrt(x**2 + y**2)\n\n    # Sharper distance shaping (exp(-3*dist) for stronger gradient near pad)\n    shaping = 2.0 * np.exp(-3.0 * dist)\n\n    # Separate velocity penalties:\n    # Horizontal speed is always bad (causes off-center landings)\n    horizontal_penalty = -0.5 * abs(vx)\n    # Vertical speed: penalize heavily when going UP (wastes fuel),\n    # gently when going down (controlled descent is good)\n    vertical_penalty = -0.5 * max(vy, 0.0) - 0.1 * abs(min(vy, 0.0))\n\n    # Angle penalty\n    angle_penalty = -0.3 * abs(angle)\n\n    # Vertical control bonus: reward low vertical speed when near ground\n    # This encourages the agent to slow down before landing\n    height_above_ground = max(y, 0.0)  # y<0 means below ground, clamp to 0\n    near_ground = float(height_above_ground < 0.5)\n    low_vy_bonus = near_ground * 0.5 * np.exp(-2.0 * abs(vy))\n\n    # Tiny step penalty\n    step_penalty = -0.03\n\n    # Terminal\n    terminal = 0.0\n    if done:\n        near_pad = abs(x) < 0.3 and y < 0.25\n        both_legs = left_leg > 0.5 and right_leg > 0.5\n        slow = abs(vx) < 0.5 and abs(vy) < 0.5\n        upright = abs(angle) < 0.3\n        if both_legs and near_pad and slow and upright:\n            terminal = 800.0\n\n    total = shaping + horizontal_penalty + vertical_penalty + angle_penalty + low_vy_bonus + step_penalty + terminal\n    return float(total), {\n        \"shaping\": shaping,\n        \"horizontal_penalty\": horizontal_penalty,\n        \"vertical_penalty\": vertical_penalty,\n        \"angle_penalty\": angle_penalty,\n        \"low_vy_bonus\": low_vy_bonus,\n        \"step_penalty\": step_penalty,\n        \"terminal\": terminal,\n    }\n",
